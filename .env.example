# Copy to .env and fill in real values. Never commit the real .env.
# Either set DATABASE_URL to a full connection string, or set the PG* vars below.

# DATABASE_URL=postgresql://user:password@localhost:5432/rapistops?sslmode=require

PGHOST=localhost
PGPORT=5432
PGDATABASE=rapistops
PGUSER=meadow
# PGPASSWORD=
# sslmode: disable | prefer | require | verify-ca | verify-full
PGSSLMODE=prefer

# Connection pool sizing (optional).
RAPISTOPS_DB_POOL_MIN=1
RAPISTOPS_DB_POOL_MAX=10
